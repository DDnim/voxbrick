    "stats": "node scripts/stats.mjs",
    "import-vox": "node scripts/import-vox.mjs",
    "build:local": "node scripts/build.mjs --local",
    "works:local": "node scripts/gen-works.mjs --local"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "three": "^0.186.1"
